{
  "doctype": "DocType",
  "name": "Lot",
  "module": "Holec Trading",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "autoname": "naming_series:",
  "naming_rule": "By \"Naming Series\" field",
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "naming_series",
      "label": "Series",
      "fieldtype": "Select",
      "options": "LOT-.YYMM.-.####",
      "reqd": 1
    },
    {
      "fieldname": "state",
      "label": "State",
      "fieldtype": "Select",
      "options": "Ticket\nIntake\nLot\nPosition\nInvoiced\nSettled",
      "default": "Ticket",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "read_only": 1,
      "description": "Advanced only via the Advance State button - not directly editable."
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "parent_lot_id",
      "label": "Parent Lot",
      "fieldtype": "Link",
      "options": "Lot",
      "description": "Set only when this Lot is the result of a split, merge, or re-bag. Null = original lot."
    },
    {
      "fieldname": "sec_break_ticket",
      "fieldtype": "Section Break",
      "label": "Source"
    },
    {
      "fieldname": "buy_ticket",
      "label": "Buy Ticket",
      "fieldtype": "Link",
      "options": "Buy Ticket",
      "in_list_view": 1
    },
    {
      "fieldname": "supplier",
      "label": "Supplier",
      "fieldtype": "Link",
      "options": "Supplier",
      "reqd": 1,
      "in_list_view": 1,
      "fetch_from": "buy_ticket.supplier",
      "read_only": 1
    },
    {
      "fieldname": "col_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "customer",
      "label": "Customer",
      "fieldtype": "Link",
      "options": "Customer",
      "description": "Set at Invoiced state."
    },
    {
      "fieldname": "sec_break_origin",
      "fieldtype": "Section Break",
      "label": "Origin"
    },
    {
      "fieldname": "county",
      "label": "County",
      "fieldtype": "Link",
      "options": "Origin County",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "area",
      "label": "Area",
      "fieldtype": "Link",
      "options": "Origin Area",
      "reqd": 1,
      "description": "Picklist that grows over time. New areas are added as records, never free text."
    },
    {
      "fieldname": "col_break_3",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "farmer",
      "label": "Farmer",
      "fieldtype": "Data"
    },
    {
      "fieldname": "aggregator",
      "label": "Aggregator",
      "fieldtype": "Data",
      "description": "Optional - set when purchased via an aggregator rather than direct from farmer."
    },
    {
      "fieldname": "transhipped",
      "label": "Transhipped",
      "fieldtype": "Check",
      "default": "0",
      "description": "Tick if load changed vehicle in transit. Widens the loss-tolerance check."
    },
    {
      "fieldname": "sec_break_weight",
      "fieldtype": "Section Break",
      "label": "Weight & Storage"
    },
    {
      "fieldname": "gross_weight_kg",
      "label": "Gross Weight (kg)",
      "fieldtype": "Float",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "bag_count",
      "label": "Bag Count",
      "fieldtype": "Int"
    },
    {
      "fieldname": "payable_weight_kg",
      "label": "Payable Weight (kg)",
      "fieldtype": "Float",
      "read_only": 1,
      "description": "Calculated: gross weight minus moisture divisor and foreign matter deduction."
    },
    {
      "fieldname": "col_break_4",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "storage_stack",
      "label": "Storage Stack",
      "fieldtype": "Link",
      "options": "Storage Stack",
      "description": "Set when Lot enters Position state and is held rather than sold direct."
    },
    {
      "fieldname": "commingled",
      "label": "Commingled",
      "fieldtype": "Check",
      "default": "0",
      "read_only": 1,
      "description": "Auto-set if this stack already holds a Lot of different origin/grade."
    },
    {
      "fieldname": "sec_break_quality",
      "fieldtype": "Section Break",
      "label": "Quality"
    },
    {
      "fieldname": "moisture_pct",
      "label": "Moisture %",
      "fieldtype": "Percent"
    },
    {
      "fieldname": "moisture_band",
      "label": "Moisture Band",
      "fieldtype": "Select",
      "options": "Under 14 - Straight In\n14 to 20 - Drying, Price Negotiated\nOver 20 - Requires Approval",
      "read_only": 1
    },
    {
      "fieldname": "requires_moisture_approval",
      "label": "Requires Approval (>20%)",
      "fieldtype": "Check",
      "default": "0",
      "read_only": 1
    },
    {
      "fieldname": "col_break_5",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "aflatoxin_tested",
      "label": "Aflatoxin Tested",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "aflatoxin_result",
      "label": "Aflatoxin Result",
      "fieldtype": "Select",
      "options": "\nPass\nFail",
      "depends_on": "aflatoxin_tested"
    },
    {
      "fieldname": "foreign_matter_pct",
      "label": "Foreign Matter %",
      "fieldtype": "Percent"
    },
    {
      "fieldname": "quality_reason_code",
      "label": "Reason Code",
      "fieldtype": "Select",
      "options": "\nVisual Condition\nOrigin Risk\nNew Supplier\nCustomer Requirement",
      "description": "Required whenever a judgement field (foreign matter, sampling decision) is entered."
    },
    {
      "fieldname": "sec_break_cost",
      "fieldtype": "Section Break",
      "label": "Cost Summary"
    },
    {
      "fieldname": "landed_cost_per_kg",
      "label": "Landed Cost / kg",
      "fieldtype": "Currency",
      "read_only": 1,
      "in_list_view": 1,
      "description": "Sum of all Cost Ledger Entries for this lot / payable_weight_kg."
    },
    {
      "fieldname": "cost_entries",
      "label": "Cost Ledger",
      "fieldtype": "Table",
      "options": "Cost Ledger Entry"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1, "write": 1, "create": 1, "delete": 1
    },
    {
      "role": "Trading Officer",
      "read": 1, "write": 1, "create": 1
    }
  ]
}
