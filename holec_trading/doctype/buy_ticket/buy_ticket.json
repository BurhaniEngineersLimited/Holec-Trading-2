{
  "doctype": "DocType",
  "name": "Buy Ticket",
  "module": "Holec Trading",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "autoname": "naming_series:",
  "naming_rule": "By \"Naming Series\" field",
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "naming_series",
      "label": "Series",
      "fieldtype": "Select",
      "options": "TCK-.YYMM.-.####",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nOpen\nConverted\nCancelled",
      "default": "Draft",
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "supplier",
      "label": "Supplier",
      "fieldtype": "Link",
      "options": "Supplier",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Must be an Approved Supplier record."
    },
    {
      "fieldname": "sec_break_trade",
      "fieldtype": "Section Break",
      "label": "Trade Terms"
    },
    {
      "fieldname": "commodity",
      "label": "Commodity",
      "fieldtype": "Select",
      "options": "Maize",
      "default": "Maize",
      "reqd": 1
    },
    {
      "fieldname": "region",
      "label": "Buying Region",
      "fieldtype": "Data",
      "description": "Buying region, distinct from the Lot's later origin (county/area) captured at intake."
    },
    {
      "fieldname": "quantity_kg",
      "label": "Quantity (kg)",
      "fieldtype": "Float",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "negotiated_price",
      "label": "Negotiated Price (KES/kg)",
      "fieldtype": "Currency",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "reference_rate",
      "label": "Reference Rate (KES/kg)",
      "fieldtype": "Currency",
      "description": "Pulled from the active Rate Card at time of entry."
    },
    {
      "fieldname": "estimated_margin_pct",
      "label": "Estimated Margin %",
      "fieldtype": "Percent",
      "read_only": 1,
      "in_list_view": 1,
      "description": "(negotiated_price - reference_rate) / reference_rate. Shown at point of decision, before money is committed."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1, "write": 1, "create": 1, "delete": 1
    },
    {
      "role": "Trading Officer",
      "read": 1, "write": 1, "create": 1
    }
  ]
}
